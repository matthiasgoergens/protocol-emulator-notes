# Synthesise multiphase_stage.v to the sg13g2 typical-corner liberty.
# Original net/register names (e.g. _144, _134, _124, _114 -- the four lane
# toggle flops) are deliberately preserved (no "rename -enumerate") so that
# the STA scripts can refer to them directly.
read_verilog /home/matthias/prog/janestreet/emulator-wt-multiphase/prototypes/multiphase/multiphase_stage.v
hierarchy -check -top multiphase_stage
proc
flatten
opt
techmap
opt
dfflibmap -liberty /home/matthias/.ciel/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
abc -liberty /home/matthias/.ciel/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
setundef -zero
opt_clean -purge

stat -liberty /home/matthias/.ciel/ihp-sg13g2/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib

write_verilog -noattr /var/tmp/multiphase/sta/multiphase_stage_synth.v
write_json /var/tmp/multiphase/sta/multiphase_stage_synth.json
