   147	
   148	def array(lib, cols, rows):
   149	    cc, tp = cell(lib), tap(lib)
   150	    a = lib.new_cell("ARRAY6T")
   151	    X, Y = 2 * XB, 2 * YB
   152	    for j in range(rows):
   153	        for i in range(cols):
   154	            # mirror columns about x, rows about y, so boundary shapes are shared
   155	            a.add(gdstk.Reference(cc, (i * X, j * Y), x_reflection=bool(j % 2),
   156	                                  rotation=0))
   157	            if i % 2:
   158	                a.references[-1].rotation = 3.141592653589793
   159	                a.references[-1].x_reflection = not bool(j % 2)
   160	    # rows mirrored: row j occupies y in [j*Y - YB, j*Y + YB]
   161	    for i in range(cols):
   162	        a.add(gdstk.Reference(tp, (i * X, (rows - 1) * Y + YB), rotation=0, x_reflection=False))
   163	        a.add(gdstk.Reference(tp, (i * X, -YB), x_reflection=True))
   164	    # Metal3 word lines: close the Via2 enclosure at both array ends
   165	    for j in range(rows):
   166	        R = lambda x0, x1: a.add(gdstk.rectangle((x0, j * Y - 0.10), (x1, j * Y + 0.10), layer=30, datatype=0))
   167	        R(-XB - 0.15, -XB)
   168	        R((cols - 1) * X + XB, (cols - 1) * X + XB + 0.15)
   169	    return a, cols * X, rows * Y
   170	
   171	
   172	if __name__ == "__main__":
   173	    cols, rows = (int(v) for v in sys.argv[1:3]) if len(sys.argv) > 2 else (4, 4)
   174	    lib = gdstk.Library(unit=1e-6, precision=5e-9)
   175	    a, w, h = array(lib, cols, rows)
   176	    lib.write_gds("sram6t.gds")
   177	    print(f"6T at standard rules: pitch {2*XB:.3f} x {2*YB:.3f} um = {4*XB*YB:.3f} um2 per bit; "
   178	          f"array {cols}x{rows}: {w:.2f} x {h:.2f} um plus a 1.07 um tap row top and bottom")

