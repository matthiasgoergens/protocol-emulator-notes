    32	LY = {"Activ": (1, 0), "GatPoly": (5, 0), "Cont": (6, 0), "Metal1": (8, 0), "Via1": (19, 0),
    33	      "Metal2": (10, 0), "Via2": (29, 0), "Metal3": (30, 0), "pSD": (14, 0), "NWell": (31, 0)}
