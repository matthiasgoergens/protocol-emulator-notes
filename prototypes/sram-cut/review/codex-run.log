   103	        u = lo + (hi - lo) * i / n
   104	        a = _interp(u1, v1, u); b = _interp(u2, v2, u)
   105	        if a is None or b is None:
   106	            continue
   107	        d = a - b
   108	        if u < 0:
   109	            best_neg = max(best_neg, d)
   110	        else:
   111	            best_pos = max(best_pos, -d)
   112	    return best_neg * r, best_pos * r, min(best_neg, best_pos) * r

