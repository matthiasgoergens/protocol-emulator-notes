   125	    R("Activ", -0.15, yn - 0.205, 0.15, yn + 0.205)
   126	    R("Cont", -0.08, yn - 0.08, 0.08, yn + 0.08)
   127	    R("Metal1", -0.105, yn - 0.215, 0.105, yn + 0.215)
   128	    R("Via1", -0.095, yn - 0.095, 0.095, yn + 0.095)
   129	    R("Metal2", -0.10, 0, 0.10, H)
   130	    # the PMOS pads of the last row stop at y = +0.15 into the tap row; pSD must cover them, and
   131	    # reaches out to the substrate ties as one polygon (separate pSD shapes would need 0.31)
   132	    R("pSD", -NW, 0, NW, 0.40)
   133	    yt = 0.605
   134	    for sg in (1, -1):
   135	        # substrate tie: P+ Activ under the VSS Metal2 track, contact to it
   136	        R("Activ", sg * XC_N - 0.15, yt - 0.205, sg * XC_N + 0.15, yt + 0.205)   # Act.d: 0.123
   137	        x0, x1 = sorted((sg * 0.18, sg * (XC_N + 0.18)))
   138	        R("pSD", x0, 0.33, x1, yt + 0.235)
   139	        R("Cont", sg * XC_N - 0.08, yt - 0.08, sg * XC_N + 0.08, yt + 0.08)
   140	        R("Metal1", sg * XC_N - 0.105, yt - 0.215, sg * XC_N + 0.105, yt + 0.215)
   141	        R("Activ", sg * NS[0] if sg > 0 else -NS[1], 0, sg * NS[1] if sg > 0 else -NS[0], 0.15)  # strip end cap
   142	        R("Via1", sg * XC_N - 0.095, yt - 0.095, sg * XC_N + 0.095, yt + 0.095)
