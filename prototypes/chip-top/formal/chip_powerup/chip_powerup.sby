# Power-up determinism of the whole chip (chip_powerup.sv); run_chip_powerup.sh prepares chip_pu.v
# and chip_pu_state.v and substitutes __DEPTH__ and __STATE_BITS__.
#   prove        pins and SRAM writes, unbounded, abc pdr
#   prove_state  as prove, plus every register reset_sync clears (STATE_EQ): stronger, and inductive
#   bmc          pins and SRAM writes, bounded, __DEPTH__ half clocks, abc bmc3
#   bmc_state    as bmc with STATE_EQ: a quick first failure of the helper, if any
#   prove_held, bmc_held  as prove_state and bmc_state, plus HELD_EQ (matcher chain equal at reset)
#   prove_ind    as prove_held, by k-induction with yices (OSS CAD Suite; run_chip_powerup.sh)
#   noreset      the control: RESET_CLOCKS=0, must FAIL
[tasks]
prove
prove_state
prove_held
prove_ind
bmc
bmc_state
bmc_held
noreset

[options]
prove: mode prove
prove_state: mode prove
bmc: mode bmc
bmc: depth __DEPTH__
bmc_state: mode bmc
bmc_state: depth __DEPTH__
prove_held: mode prove
prove_ind: mode prove
prove_ind: depth 8
bmc_held: mode bmc
bmc_held: depth __DEPTH__
noreset: mode bmc
noreset: depth 40
multiclock on
# no SMT solver in the librelane image: verdicts only, no counterexample trace
~prove_ind: aigsmt none

[engines]
prove: abc pdr
prove_state: abc pdr
bmc: abc bmc3
bmc_state: abc bmc3
prove_held: abc pdr
prove_ind: smtbmc yices
bmc_held: abc bmc3
noreset: abc bmc3

[script]
prove: read -formal chip_pu.v
bmc: read -formal chip_pu.v
noreset: read -formal chip_pu.v
prove_state: read -formal chip_pu_state.v
bmc_state: read -formal chip_pu_state.v
prove_held: read -formal chip_pu_state.v
prove_ind: read -formal chip_pu_state.v
bmc_held: read -formal chip_pu_state.v
prove: read -formal chip_powerup.sv
bmc: read -formal chip_powerup.sv
noreset: read -formal chip_powerup.sv
prove_state: read -formal -D STATE_EQ=__STATE_BITS__ -D HELD_BITS=__HELD_BITS__ chip_powerup.sv
bmc_state: read -formal -D STATE_EQ=__STATE_BITS__ -D HELD_BITS=__HELD_BITS__ chip_powerup.sv
prove_held: read -formal -D STATE_EQ=__STATE_BITS__ -D HELD_BITS=__HELD_BITS__ -D HELD_EQ chip_powerup.sv
prove_ind: read -formal -D STATE_EQ=__STATE_BITS__ -D HELD_BITS=__HELD_BITS__ -D HELD_EQ chip_powerup.sv
bmc_held: read -formal -D STATE_EQ=__STATE_BITS__ -D HELD_BITS=__HELD_BITS__ -D HELD_EQ chip_powerup.sv
noreset: chparam -set RESET_CLOCKS 0 chip_powerup
prep -top chip_powerup

[files]
chip_pu.v
chip_pu_state.v
chip_powerup.sv
