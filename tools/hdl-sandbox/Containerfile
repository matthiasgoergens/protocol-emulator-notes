# Simulators and checkers for running other people's HDL (and its counterexamples) in isolation.
# Run with: podman run --rm --network=none --volume SRC:/src:ro,Z --volume OUT:/out:Z hdl-sandbox ...
FROM docker.io/library/debian:trixie
RUN apt-get update \
 && apt-get install --yes --no-install-recommends iverilog verilator yosys z3 python3 make g++ \
 && (apt-get install --yes --no-install-recommends symbiyosys boolector || true) \
 && rm --recursive --force /var/lib/apt/lists/*
RUN useradd --create-home sandbox
USER sandbox
WORKDIR /out
