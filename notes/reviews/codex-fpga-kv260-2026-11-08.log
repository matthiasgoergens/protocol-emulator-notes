     2	 * SPDX-License-Identifier: Apache-2.0
     3	 * Top level for the KV260: the block design (the Zynq processor system and kv260_core, built by
     4	 * ../vivado/build.tcl, which also generates kv260_bd_wrapper) and the carrier's Pmod connector.
     5	 *
     6	 * Pmod pins (../constraints/kv260.xdc):
     7	 *   1 uo_out[0]  UART TX         7 uio[6]  I2C SDA, open drain
     8	 *   2 uo_out[1]  SPI SCLK        8 uio[7]  I2C SCL, open drain
     9	 *   3 uo_out[2]  SPI MOSI        9 ui_in[0], when UI_MASK bit 0 is set
    10	 *   4 uo_out[3]  SPI CS         10 heartbeat: toggles every 0.5 s at 60 MHz
    11	 * (the UART, SPI and I2C demo's pins; other demos may use them differently)
    12	 */
    13	
    14	`default_nettype none
    15	
    16	module kv260_top (
    17	    output wire pmod1,
    18	    output wire pmod2,
    19	    output wire pmod3,
    20	    output wire pmod4,
    21	    inout  wire pmod7,
    22	    inout  wire pmod8,
    23	    input  wire pmod9,
    24	    output wire pmod10,
    25	    output wire fan_en_b
