     1	#!/usr/bin/env python3
     2	# SPDX-License-Identifier: Apache-2.0
     3	"""Run frames on the KV260 test bench, from the board's own Linux (as root, for /dev/mem).
     4	
     5	    kv260_run.py FRAMES OUT_PREFIX [--base 0xA0000000] [--repeat N]
     6	
     7	Does what sim/tb_bench.v does in simulation and writes the same files: OUT_PREFIX.info,
     8	.samples and .trace. So `diff` against a simulation of the same frames compares the board with
     9	the simulation clock for clock, and host/check.py judges either.
    10	
    11	Before the run it checks the bench's identifier and measures the chip clock with the bench's
    12	free-running counter; it stops if the clock is not 60 MHz within 1 %, since a wrong or stopped
    13	PL clock is the likeliest first-bring-up fault. With --repeat N it runs N times and stops at the
    14	first run whose files differ from the first: the run is fixed clock by clock, so they should not.
    15	
    16	Python standard library only. --base is where the block design put kv260_core (build.tcl prints
    17	it; M_AXI_HPM0_FPD's window starts at 0xA0000000).
    18	"""
    19	import argparse
    20	import ctypes
    21	import mmap
    22	import os
    23	import sys
    24	import time
    25	
    26	ID = 0x46423031
    27	
    28	
    29	class Bench:
    30	    def __init__(self, base):
    31	        fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
    32	        self.mm = mmap.mmap(fd, 4096, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=base)
    33	        os.close(fd)
    34	
    35	    def rd(self, off):
    36	        # one 32-bit load: some registers advance an address when read
    37	        return ctypes.c_uint32.from_buffer(self.mm, off).value
    38	
    39	    def wr(self, off, v):
    40	        ctypes.c_uint32.from_buffer(self.mm, off).value = v & 0xFFFFFFFF
    41	
    42	
    43	def clock_mhz(b, seconds=0.5):
    44	    t0, c0 = time.monotonic(), b.rd(0x1C)
    45	    time.sleep(seconds)
    46	    t1, c1 = time.monotonic(), b.rd(0x1C)
    47	    return ((c1 - c0) & 0xFFFFFFFF) / (t1 - t0) / 1e6
    48	
    49	
    50	def run(b, frames, prefix):
    51	    b.wr(0x04, 2)                                 # stop: idle, chip in reset
    52	    b.wr(0x10, 0)
    53	    for w in frames:
    54	        b.wr(0x14, w)
    55	    if b.rd(0x10) != len(frames):
    56	        sys.exit(f"frame memory: FRAME_ADDR {b.rd(0x10)} after {len(frames)} frames")
    57	    b.wr(0x04, 1)
    58	    t0 = time.monotonic()
    59	    while b.rd(0x04) & 1:
    60	        if time.monotonic() - t0 > 60:
    61	            sys.exit("run did not finish in 60 s")
    62	        time.sleep(0.001)
    63	    status, played = b.rd(0x04), b.rd(0x18)
    64	    with open(prefix + ".info", "w") as f:
    65	        f.write(f"status {status}\nclocks {played}\n")
    66	    n = b.rd(0x20)
    67	    b.wr(0x24, 0)
    68	    with open(prefix + ".samples", "w") as f:
    69	        for _ in range(n):
    70	            f.write(f"{b.rd(0x28) & 0xF:01x}\n")
    71	    v = b.rd(0x2C)
    72	    n = v & 0x7FFFFFFF
    73	    b.wr(0x30, 0)
    74	    with open(prefix + ".trace", "w") as f:
    75	        for _ in range(n):
    76	            w0, w1, w2 = b.rd(0x34), b.rd(0x38), b.rd(0x3C)
    77	            f.write(f"{w0} {w1:08x} {w2:08x}\n")
    78	    return status, played, n
    79	
    80	
    81	def main():
    82	    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    83	    ap.add_argument("frames")
    84	    ap.add_argument("prefix")
    85	    ap.add_argument("--base", type=lambda s: int(s, 0), default=0xA0000000)
    86	    ap.add_argument("--repeat", type=int, default=1)
    87	    a = ap.parse_args()
    88	    frames = []
    89	    for line in open(a.frames):
    90	        w = int(line, 16)
    91	        frames.append(w)
    92	        if w == 0:
    93	            break
    94	    else:
    95	        sys.exit("no end frame")
    96	    b = Bench(a.base)
    97	    if b.rd(0x00) != ID:
    98	        sys.exit(f"identifier {b.rd(0x00):#010x} at {a.base:#x}, want {ID:#010x}: wrong --base, or the bitstream is not loaded")
    99	    mhz = clock_mhz(b)
   100	    print(f"chip clock: {mhz:.3f} MHz")
   101	    if abs(mhz - 60) > 0.6:
   102	        sys.exit("the chip clock is not 60 MHz: check pl_clk0 (it is set by the device tree overlay when the bitstream is loaded)")
   103	    first = None
   104	    for k in range(a.repeat):
   105	        prefix = a.prefix if k == 0 else f"{a.prefix}.rep{k}"
   106	        status, played, n = run(b, frames, prefix)
   107	        print(f"run {k}: status {status}, {played} clocks, {n} trace entries -> {prefix}.*")
   108	        files = [open(prefix + s).read() for s in (".info", ".samples", ".trace")]
   109	        if first is None:
   110	            first = files
   111	        elif files != first:
   112	            sys.exit(f"run {k} differs from run 0")
   113	    if a.repeat > 1:
   114	        print(f"all {a.repeat} runs identical")
   115	
   116	
   117	if __name__ == "__main__":
   118	    main()

