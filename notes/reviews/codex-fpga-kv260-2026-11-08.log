     1	#!/usr/bin/env python3
     2	# SPDX-License-Identifier: Apache-2.0
     3	"""Judge a run of the UART, SPI and I2C demo on the FPGA test bench from its recorded files.
     4	
     5	    check.py META PREFIX [--i2c-device]
     6	
     7	META is ds.meta from ../chip-top/bin/fpga_ops.exe; PREFIX.info, .trace and .samples come from
     8	kv260_run.py on the board or from sim/tb_bench.v. The trace is decoded on its own (it does not
     9	need a simulation to compare with): the UART bytes on uo_out[0] and their bit timing, the SPI
    10	bytes on uo_out[3:1], the I2C bytes and acknowledges on uio[7:6], and the bytes the host drained
    11	from HOSTOUT. Without --i2c-device nothing answers on the I2C bus, so every byte must be
    12	unacknowledged and the controller reports 0x01 per byte; with it, a device at address 0x50 (for
    13	example a 24C-series EEPROM) must acknowledge both bytes and the controller reports 0x00.
    14	"""
    15	import sys
    16	
    17	
    18	def read_meta(path):
    19	    meta = {}
    20	    for line in open(path):
    21	        if line.startswith("#") or not line.strip():
    22	            continue
    23	        k, v = line.split(None, 1)
    24	        v = v.strip()
    25	        meta[k] = [int(x) for x in v.split(",")] if "," in v else int(v)
    26	    return meta
    27	
    28	
    29	def read_trace(path, total):
    30	    """Per clock, for the [total] clocks played: (uo 1st half, uo 2nd half, uio_in)."""
    31	    entries = []
    32	    for line in open(path):
    33	        c, w1, w2 = line.split()
    34	        entries.append((int(c), int(w1, 16), int(w2, 16)))
    35	    clocks = []
    36	    for (c, w1, w2), nxt in zip(entries, entries[1:] + [None]):
    37	        end = nxt[0] if nxt else total
    38	        for _ in range(c, end):
    39	            clocks.append((w1 & 0xFF, (w1 >> 8) & 0xFF, (w2 >> 16) & 0xFF))
    40	    return clocks
    41	
    42	
    43	def bit(v, i):
    44	    return (v >> i) & 1
    45	
    46	
    47	def uart(clocks, start, bit_clocks):
    48	    """8N1 bytes on uo_out[0]; returns (byte, clock of start bit, framing ok)."""
    49	    out, c = [], start
    50	    lv = [bit(h2, 0) for _, h2, _ in clocks]
    51	    while c < len(lv) - 10 * bit_clocks:
    52	        if lv[c - 1] == 1 and lv[c] == 0:
    53	            mid = c + bit_clocks // 2
    54	            bits = [lv[mid + k * bit_clocks] for k in range(1, 9)]
    55	            stop = lv[mid + 9 * bit_clocks]
    56	            out.append((sum(b << k for k, b in enumerate(bits)), c, stop == 1 and lv[mid] == 0))
    57	            c = mid + 9 * bit_clocks
    58	        c += 1
    59	    return out
    60	
    61	
    62	def spi(clocks, start):
    63	    """Mode 0, msb first: MOSI uo_out[2] at each rise of SCLK uo_out[1] while CS uo_out[3] is low."""
    64	    out, cur, n = [], 0, 0
    65	    for c in range(max(start, 1), len(clocks)):
    66	        p, q = clocks[c - 1][1], clocks[c][1]
    67	        if bit(q, 3) == 1:
    68	            cur, n = 0, 0
    69	            continue
    70	        if bit(p, 1) == 0 and bit(q, 1) == 1:
    71	            cur = (cur << 1) | bit(q, 2)
    72	            n += 1
    73	            if n == 8:
    74	                out.append(cur)
    75	                cur, n = 0, 0
    76	    return out
    77	
    78	
    79	def i2c(clocks, start):
    80	    """Bytes with their acknowledge bit (0 = acknowledged), and whether a STOP followed."""
    81	    sda = [bit(u, 6) for _, _, u in clocks]
    82	    scl = [bit(u, 7) for _, _, u in clocks]
    83	    out, bits, active, stopped = [], [], False, False
    84	    for c in range(max(start, 1), len(clocks)):
    85	        if scl[c] and scl[c - 1] and sda[c - 1] and not sda[c]:
    86	            active, bits, stopped = True, [], False
    87	        elif scl[c] and scl[c - 1] and not sda[c - 1] and sda[c]:
    88	            active, stopped = False, True
    89	        elif active and not scl[c - 1] and scl[c]:
    90	            bits.append(sda[c])
    91	            if len(bits) == 9:
    92	                out.append((sum(b << (7 - k) for k, b in enumerate(bits[:8])), bits[8]))
    93	                bits = []
    94	    return out, stopped
    95	
    96	
    97	def hostout(samples):
    98	    nib = [int(x, 16) for x in samples]
    99	    by = [(nib[i] << 4) | nib[i + 1] for i in range(0, len(nib) - 1, 2)]
   100	    return [d for t, d in zip(by[0::2], by[1::2]) if t & 0x80]
   101	
   102	
   103	def main():
   104	    args = [a for a in sys.argv[1:] if not a.startswith("--")]
   105	    device = "--i2c-device" in sys.argv
   106	    if len(args) != 2:
   107	        sys.exit(__doc__)
   108	    meta = read_meta(args[0])
   109	    info = read_meta(args[1] + ".info")
   110	    clocks = read_trace(args[1] + ".trace", info["clocks"])
   111	    samples = open(args[1] + ".samples").read().split()
   112	    run = meta["run_clock"]
   113	    ok = True
   114	
   115	    def judge(name, good, detail):
   116	        nonlocal ok
   117	        ok &= good
   118	        print(f"  {name}: {'ok' if good else 'WRONG'}: {detail}")
   119	
   120	    print(f"{len(clocks)} clocks in the trace (expected {meta['clocks']}), run set at clock {run}")
   121	    judge("run", info["status"] == 2 and len(clocks) == meta["clocks"],
   122	          f"status {info['status']} (2: done, nothing dropped), {len(clocks)} clocks played")
   123	    u = uart(clocks, run, meta["uart_bit_clocks"])
   124	    judge("uart bytes", [b for b, _, f in u if f] == meta["uart_bytes"] and all(f for _, _, f in u),
   125	          " ".join(f"0x{b:02x}@{c}{'' if f else '(framing)'}" for b, c, f in u))
   126	    lv = [bit(h2, 0) for _, h2, _ in clocks]
   127	    edges = [c for c in range(run, len(lv)) if lv[c] != lv[c - 1]]
   128	    off = [(e - edges[0]) % meta["uart_bit_clocks"] for e in edges] if edges else []
   129	    judge("uart edge spacing", bool(edges) and not any(off), f"{len(edges)} edges, all on the {meta['uart_bit_clocks']}-clock grid: {not any(off)}")
   130	    s = spi(clocks, run)
   131	    judge("spi bytes", s == meta["spi_bytes"], " ".join(f"0x{b:02x}" for b in s))
   132	    i, stopped = i2c(clocks, run)
   133	    want_ack = 0 if device else 1
   134	    judge("i2c bytes", [b for b, _ in i] == meta["i2c_bytes"] and all(a == want_ack for _, a in i) and stopped,
   135	          " ".join(f"0x{b:02x}{'+ack' if a == 0 else '-nak'}" for b, a in i) + f" stop={stopped}")
   136	    h = hostout(samples)
   137	    want = [want_ack] * len(meta["i2c_bytes"])
   138	    judge("host drained", h == want, " ".join(f"0x{b:02x}" for b in h) + f" (want {' '.join(f'0x{b:02x}' for b in want)})")
   139	    print("PASS" if ok else "FAIL")
   140	    sys.exit(0 if ok else 1)
   141	
   142	
   143	if __name__ == "__main__":
   144	    main()

